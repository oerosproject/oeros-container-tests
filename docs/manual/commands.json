 "PS-005": {
  "steps": [
   {
    "cmd": [
     "sh",
     "-c",
     ". /opt/ros/lyrical/setup.sh || exit 1\n\nmkdir -p /tmp/ws/src && cd /tmp/ws/src || exit 1\nros2 pkg create --build-type ament_cmake --node-name my_node my_cmake_pkg >/tmp/create1.log 2>&1; rc=$?\necho \"##CREATE_CMAKE\"; echo \"exit=$rc\"\nros2 pkg create --build-type ament_python --node-name my_py_node my_py_pkg >/tmp/create2.log 2>&1; rc=$?\necho \"##CREATE_PYTHON\"; echo \"exit=$rc\"\ncd /tmp/ws\ncolcon build >/tmp/build.log 2>&1; rc=$?\necho \"##BUILD\"; echo \"exit=$rc\"; tail -n 5 /tmp/build.log\n. install/setup.sh\necho \"##RUN_CMAKE\"; ros2 run my_cmake_pkg my_node; echo \"exit=$?\"\necho \"##RUN_PYTHON\"; ros2 run my_py_pkg my_py_node; echo \"exit=$?\"\n"
    ],
    "covers": [
     "AC1",
     "AC2",
     "AC3",
     "AC4"
    ],
    "entrypoint": null,
    "env": {},
    "families": [
     "oeros",
